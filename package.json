  },
  "dependencies": {
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "ws": "^8.22.0"
  }
